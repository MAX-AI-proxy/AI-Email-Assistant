{
  "name": "ai-email-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:public": "node scripts/audit-public.mjs",
    "export:public": "node scripts/export-public.mjs",
    "build:demo": "npm run check:demo && vite build --config demo/vite.config.mts",
    "check:demo": "node --conditions=react-server --import tsx scripts/check-demo.mts",
    "generate:demo": "node --conditions=react-server --import tsx scripts/generate-demo.mts",
    "preview:demo": "vite preview --config demo/vite.config.mts --host 127.0.0.1 --port 3200",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "audit:staged": "node scripts/audit-staged.mjs",
    "manifest:public": "node scripts/update-manifest.mjs"
  },
  "dependencies": {
    "imapflow": "^1.7.1",
    "lucide-react": "^1.31.0",
    "mailparser": "^3.9.15",
    "next": "16.4.0",
    "openai": "^7.30.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
