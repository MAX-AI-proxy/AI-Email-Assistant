# Copy to .env.local and supply your own credentials. Leave unused accounts blank.
# No NEXT_PUBLIC_ prefix: every value below is server-only.

# T-Online: full address and the provider's separate IMAP/app password.
T_ONLINE_EMAIL=
T_ONLINE_APP_PASSWORD=

# TU Braunschweig: address, institutional IMAP login, and password.
TU_EMAIL_ADDRESS=
TU_EMAIL_USERNAME=
TU_EMAIL_PASSWORD=

# OpenAI: your own API key. AI analysis currently supports T-Online only.
OPENAI_API_KEY=

# Set false to disable background analysis. Reading a T-Online mail still
# analyzes it on opening. Both actions can incur API charges when configured.
MAX_AI_AUTO_ANALYSIS=true
